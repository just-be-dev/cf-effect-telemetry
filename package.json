{
  "name": "@just-be/cf-effect-telemetry",
  "version": "0.1.0",
  "description": "Effect v4 tracer provider for Cloudflare Workers custom spans",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.92"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "check": "bun run typecheck && bun run test",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.19.0",
    "@types/bun": "latest",
    "effect": "4.0.0-beta.92",
    "typescript": "7.0.2"
  }
}
